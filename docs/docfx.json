{
  "build": {
    "globalMetadata": {
      "_appTitle": "Struckig Documentation",
      "_appFooter": "Struckig: online trajectory generation for Structured Text and TwinCAT 3.",
      "_appLogoPath": "images/struckig-logo.svg",
      "_appFaviconPath": "images/struckig-logo.svg"
    },
    "content": [
      {
        "files": [
          "userguide/*.md",
          "userguide/toc.yml",      
          "reference/**/*.md",
          "reference/toc.yml",
          "reference/**/toc.yml",
          "toc.yml",
          "*.md"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "styles/**"
        ]
      }
    ],
    "dest": "html",
    "fileMetadataFiles": [],
    "template": [
      "default",
      "modern",
      "template"
    ],
    "postProcessors": [],
    "markdownEngineName": "markdig",
    "noLangKeyword": false,
    "keepFileLink": false,
    "cleanupCacheHistory": false,
    "disableGitFeatures": false
  }
}
