{attribute 'qualified_only'}
/// Global configuration constants for Struckig.
/// These values define library limits and algorithm defaults that are
/// referenced by trajectory generation and numerical helper routines.
VAR_GLOBAL CONSTANT
  MaxDoFs : INT := 7; //< Maximum number of degrees of freedom supported by `Otg`.
  MaxIterations : BYTE := 127; //< Maximum iterations when [shrinking an interval](xref:Struckig.Roots#ShrinkInterval)
  NumericalRobust : BOOL := TRUE; //< Enables additional guards for numerically robust calculations.
  
  /// Default initial value for Otg.SmoothBrake / Otg1.SmoothBrake
  /// If enabled, braking profiles prefer smooth acceleration transitions.
  SmoothBrake : BOOL := FALSE;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>