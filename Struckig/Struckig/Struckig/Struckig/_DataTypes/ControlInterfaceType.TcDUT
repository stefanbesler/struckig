{attribute 'qualified_only'}
{attribute 'strict'}
/// Defines the controlled state variables for trajectory generation.
/// The selected mode changes which boundary values and limits are interpreted
/// during validation and profile generation.
TYPE ControlInterfaceType :
(
  Undefined, //< Use global/default configuration.
  Position, //< Full control over position, velocity, and acceleration.
  Velocity //< Controls only velocity and acceleration states.
);
END_TYPE
]]></Declaration>
  </DUT>
</TcPlcObject>