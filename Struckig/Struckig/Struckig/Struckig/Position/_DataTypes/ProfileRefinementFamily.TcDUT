/// Profile families of PositionThirdOrderStep2 that are refined with Newton iterations
{attribute 'qualified_only'}
{attribute 'strict'}
TYPE INTERNAL ProfileRefinementFamily :
(
  Acc1VelUddu := 1, //< time_acc1_vel UDDU
  Acc1VelUdud, //< time_acc1_vel UDUD
  Acc0VelUddu, //< time_acc0_vel UDDU
  Acc0VelUdud, //< time_acc0_vel UDUD
  VelRestToRest, //< time_vel rest-to-rest
  VelUddu, //< time_vel UDDU
  VelUdud //< time_vel UDUD
);
END_TYPE
]]></Declaration>
  </DUT>
