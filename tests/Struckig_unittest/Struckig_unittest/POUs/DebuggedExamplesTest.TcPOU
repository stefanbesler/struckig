      <Implementation>
        <ST><![CDATA[TEST('Trajectory_TimeSync_TimeAcc1');

ruckig();

// time_acc1 must take sqrt(h0)/jMax before folding h0 into h1 (github.com/stefanbesler/struckig/issues/32)
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Synchronization failed');
AssertEquals_LREAL(Expected := 0.6763389192994883, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

TEST_FINISHED();]]></ST>
