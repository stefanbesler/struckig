]]></ST>
    </Implementation>
    <Method Name="Test_Trajectory_HasTargetVelocity_HasTargetAcceleration" Id="{53ec57f4-9f8e-4639-b25f-deb391855d1e}">
      <Declaration><![CDATA[METHOD Test_Trajectory_HasTargetVelocity_HasTargetAcceleration
VAR_INST
  ruckig : Struckig.Otg(0.001, 3) := (
  
    Synchronization := SynchronizationType.TimeSync,        
    MaxVelocity := [ 2000.00000000000000000000, 2000.00000000000000000000, 2000.00000000000000000000 ],
    MaxAcceleration := [ 20000.00000000000000000000, 20000.00000000000000000000, 20000.00000000000000000000 ],
    MaxJerk := [ 800000.00000000000000000000, 800000.00000000000000000000, 800000.00000000000000000000 ],
    CurrentPosition := [ -54.94342725690739825950, -71.16344937395382430623, -99.92141940871530891854 ],
    CurrentVelocity := [ 203.04708462957614756306, -87.88615914847480325989, -244.40742200449426491105 ],
    CurrentAcceleration := [ -9414.24830241836389177479, 3433.58972946014000626747, -1048.10905719350193976425 ],
    TargetPosition := [ -30.34627507739200780179, 41.33313071646210801191, 94.47974487226861128875 ],
    TargetVelocity := [ -104.33706621689987059654, -659.36109838358197521302, 811.33117925934993763804 ],
    TargetAcceleration := [ 523.43053514200096287823, 100.75104632855459385610, 320.80199262854853259341 ]
  );
  
  positionExtrema : Struckig.ProfileBound;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_Profile[1]_Step2_TimeVel');

ruckig();

// Check total duration of profiles
AssertEquals_LREAL(Expected := 0.22338925049474450679, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

// Check duration for each phase
positionExtrema := ruckig._profiles[0].Bound();
AssertEquals_LREAL(0.20657109030979783904, positionExtrema.Tmax, 1E-9, message:='Profile[0] Tmax incorrect');
AssertEquals_LREAL(-29.15176131633907630203, positionExtrema.Maximum, 1E-9, message:='Profile[0] maximum incorrect');
AssertEquals_LREAL(0.00000000000000000000, positionExtrema.Tmin, 1E-9, message:='Profile[0] Tmin incorrect');
AssertEquals_LREAL(-54.94342725690739825950, positionExtrema.Minimum, 1E-9, message:='Profile[0] minimum incorrect');

positionExtrema := ruckig._profiles[1].Bound();
AssertEquals_LREAL(0.19826331168683380968, positionExtrema.Tmax, 1E-9, message:='Profile[1] Tmax incorrect');
AssertEquals_LREAL(55.81702313192161568622, positionExtrema.Maximum, 1E-9, message:='Profile[1] maximum incorrect');
AssertEquals_LREAL(0.01113968648909354625, positionExtrema.Tmin, 1E-9, message:='Profile[1] Tmin incorrect');
AssertEquals_LREAL(-71.74511835894615785492, positionExtrema.Minimum, 1E-9, message:='Profile[1] minimum incorrect');

positionExtrema := ruckig._profiles[2].Bound();
AssertEquals_LREAL(0.22338925049474447904, positionExtrema.Tmax, 1E-9, message:='Profile[2] Tmax incorrect');
AssertEquals_LREAL(94.47974487226861128875, positionExtrema.Maximum, 1E-9, message:='Profile[2] maximum incorrect');
AssertEquals_LREAL(0.02606362117094545780, positionExtrema.Tmin, 1E-9, message:='Profile[2] Tmin incorrect');
AssertEquals_LREAL(-104.28684661857214166503, positionExtrema.Minimum, 1E-9, message:='Profile[2] minimum incorrect');
   

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_Acc0_AccelerationPlateauAtLimit" Id="{ee2cd1c1-0183-4de5-8289-c1eec1ba6573}">
      <Declaration><![CDATA[METHOD Test_Trajectory_Acc0_AccelerationPlateauAtLimit
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    MaxVelocity := [ 10000.0 ],
    MinVelocity := [ -10000.0 ],
    MaxAcceleration := [ 6000.0 ],
    MinAcceleration := [ -6000.0 ],
    MaxJerk := [ 60000.0 ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ -94.046338722055737 ],
    CurrentAcceleration := [ -1713.4692120085324 ],
    TargetPosition := [ 109.73911741991981 ],
    TargetVelocity := [ 0.0 ],
    TargetAcceleration := [ 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_Acc0_AccelerationPlateauAtLimit');

ruckig();

// The acceleration plateau a[1] rounds to 6000.000000000002 unless it is pinned to MaxAcceleration
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step1 must find the Acc0 profile');
AssertEquals_LREAL(Expected := 0.44829524729797687, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := 6000.0, Actual := ruckig._profiles[0].a[1], DELTA := 0.0, Message := 'Acceleration plateau not at limit');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_Acc0_AccelerationPlateauAtLimit_HasMinDuration" Id="{1269a987-6727-40ec-8666-df59a6c61196}">
      <Declaration><![CDATA[METHOD Test_Trajectory_Acc0_AccelerationPlateauAtLimit_HasMinDuration
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    MinDuration := 10.0,
    MaxVelocity := [ 10000.0 ],
    MinVelocity := [ -10000.0 ],
    MaxAcceleration := [ 6000.0 ],
    MinAcceleration := [ -6000.0 ],
    MaxJerk := [ 60000.0 ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ -94.046338722055737 ],
    CurrentAcceleration := [ -1713.4692120085324 ],
    TargetPosition := [ 109.73911741991981 ],
    TargetVelocity := [ 0.0 ],
    TargetAcceleration := [ 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_Acc0_AccelerationPlateauAtLimit_HasMinDuration');

ruckig();

AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step1 must find the Acc0 profile');
AssertEquals_LREAL(Expected := 10.0, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_Acc0Acc1Vel_VelocityPlateauAtLimit" Id="{467eef6b-1af2-4cb9-a189-8d26d0379d86}">
      <Declaration><![CDATA[METHOD Test_Trajectory_Acc0Acc1Vel_VelocityPlateauAtLimit
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    MaxVelocity := [ 20000.0 ],
    MinVelocity := [ -20000.0 ],
    MaxAcceleration := [ 8000.0 ],
    MinAcceleration := [ -8000.0 ],
    MaxJerk := [ 160000.0 ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ -7579.2062160861233 ],
    CurrentAcceleration := [ 3470.3044400995882 ],
    TargetPosition := [ 95107.891634367508 ],
    TargetVelocity := [ 0.0 ],
    TargetAcceleration := [ 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_Acc0Acc1Vel_VelocityPlateauAtLimit');

ruckig();

// The velocity plateau v[3] rounds past MaxVelocity unless it is pinned to the limit
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step1 must find the Acc0Acc1Vel profile');
AssertEquals_LREAL(Expected := 8.418385493207925, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := 8000.0, Actual := ruckig._profiles[0].a[1], DELTA := 0.0, Message := 'First acceleration plateau not at limit');
AssertEquals_LREAL(Expected := 20000.0, Actual := ruckig._profiles[0].v[3], DELTA := 0.0, Message := 'Velocity plateau not at limit');
AssertEquals_LREAL(Expected := -8000.0, Actual := ruckig._profiles[0].a[5], DELTA := 0.0, Message := 'Second acceleration plateau not at limit');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_Acc0Acc1Vel_AccelerationPlateausAtLimit_HasMinDuration" Id="{f11c0b21-8717-4407-a864-c194f5ae6fb4}">
      <Declaration><![CDATA[METHOD Test_Trajectory_Acc0Acc1Vel_AccelerationPlateausAtLimit_HasMinDuration
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    MinDuration := 0.52280705016359763,
    MaxVelocity := [ 10000.0 ],
    MinVelocity := [ -10000.0 ],
    MaxAcceleration := [ 50000.0 ],
    MinAcceleration := [ -50000.0 ],
    MaxJerk := [ 5000000.0 ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ 7601.3041262859115 ],
    CurrentAcceleration := [ 20308.779305483265 ],
    TargetPosition := [ -899.42149604790268 ],
    TargetVelocity := [ 0.0 ],
    TargetAcceleration := [ -11354.996570480182 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_Acc0Acc1Vel_AccelerationPlateausAtLimit_HasMinDuration');

ruckig();

// Step2 profile, both acceleration plateaus round past the limits unless they are pinned
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step2 must find the Acc0Acc1Vel profile');
AssertEquals_LREAL(Expected := 0.52280705016359763, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := -50000.0, Actual := ruckig._profiles[0].a[1], DELTA := 0.0, Message := 'First acceleration plateau not at limit');
AssertEquals_LREAL(Expected := 50000.0, Actual := ruckig._profiles[0].a[5], DELTA := 0.0, Message := 'Second acceleration plateau not at limit');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_VelocityInterface_Acc0_AccelerationPlateauAtLimit" Id="{01147c24-da04-4188-abd1-14ec731bf37b}">
      <Declaration><![CDATA[METHOD Test_Trajectory_VelocityInterface_Acc0_AccelerationPlateauAtLimit
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    ControlInterface := ControlInterfaceType.Velocity,
    MaxVelocity := [ 5000.0 ],
    MinVelocity := [ -5000.0 ],
    MaxAcceleration := [ 100000.0 ],
    MinAcceleration := [ -100000.0 ],
    MaxJerk := [ 10000000.0 ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ -2004.9705503892574 ],
    CurrentAcceleration := [ -40342.055630859963 ],
    TargetPosition := [ 33.637068796201952 ],
    TargetVelocity := [ 491.86104908487664 ],
    TargetAcceleration := [ 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_VelocityInterface_Acc0_AccelerationPlateauAtLimit');

ruckig();

// The acceleration plateau a[1] rounds past MaxAcceleration unless it is pinned to the limit
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step1 must find the Acc0 profile');
AssertEquals_LREAL(Expected := 0.039816262284089042, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := 100000.0, Actual := ruckig._profiles[0].a[1], DELTA := 0.0, Message := 'Acceleration plateau not at limit');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_SecondOrder_Acc0_VelocityPlateauAtLimit" Id="{abce5fe7-ea05-4bb9-a48f-4248f763267a}">
      <Declaration><![CDATA[METHOD Test_Trajectory_SecondOrder_Acc0_VelocityPlateauAtLimit
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    MaxVelocity := [ 20000.0 ],
    MinVelocity := [ -20000.0 ],
    MaxAcceleration := [ 10000.0 ],
    MinAcceleration := [ -10000.0 ],
    MaxJerk := [ Struckig.Constants.Infinity ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ 17181.182985859396 ],
    CurrentAcceleration := [ 2665.3424926174239 ],
    TargetPosition := [ -47400.39401181406 ],
    TargetVelocity := [ -918.32092447330888 ],
    TargetAcceleration := [ 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_SecondOrder_Acc0_VelocityPlateauAtLimit');

ruckig();

// The velocity plateau v[1] rounds past MinVelocity unless it is pinned to the limit
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step1 must find the second order Acc0 profile');
AssertEquals_LREAL(Expected := 6.7363968120140862, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := -20000.0, Actual := ruckig._profiles[0].v[1], DELTA := 0.0, Message := 'Velocity plateau not at limit');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_TimeSync_Brake_ReusesMinimalProfile" Id="{91e2399f-b5af-480a-a420-53f7539c5cec}">
      <Declaration><![CDATA[METHOD Test_Trajectory_TimeSync_Brake_ReusesMinimalProfile
VAR_INST
  ruckig : Struckig.Otg(0.01, 3) := (
    Synchronization := SynchronizationType.TimeSync,
    MaxVelocity := [ 500.0, 500.0, 500.00000000000006 ],
    MinVelocity := [ -500.0, -500.0, -500.00000000000006 ],
    MaxAcceleration := [ 10000.0, 10000.0, 10000.0 ],
    MinAcceleration := [ -10000.0, -10000.0, -10000.0 ],
    MaxJerk := [ 10000.0, 10000.0, 10000.0 ],
    CurrentPosition := [ 0.0, 0.0, 0.0 ],
    CurrentVelocity := [ 0.0, 0.0, 0.0 ],
    CurrentAcceleration := [ -10000.0, -10000.0, -10000.0 ],
    TargetPosition := [ -529.28902218825328, -529.28902218825419, -529.28902218825249 ],
    TargetVelocity := [ 319.73181177710467, 319.73181177710467, 319.73181177710467 ],
    TargetAcceleration := [ 0.0, 0.0, 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_TimeSync_Brake_ReusesMinimalProfile');

ruckig();

// All DoFs need a brake phase; the synchronized duration equals the minimal duration of the limiting DoF
// and the other DoFs have to reuse their own minimal profiles (Step2 is degenerate at that duration)
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Time synchronization failed');
AssertEquals_LREAL(Expected := 14.814314010284143, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_Acc0Acc1Vel_Udud_HasMinDuration" Id="{a9c3aa6d-ab74-4e41-bb2c-9aa59b42885a}">
      <Declaration><![CDATA[METHOD Test_Trajectory_Acc0Acc1Vel_Udud_HasMinDuration
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    MinDuration := 9.4593236196069377,
    MaxVelocity := [ 100000.0 ],
    MinVelocity := [ -100000.0 ],
    MaxAcceleration := [ 50000.0 ],
    MinAcceleration := [ -50000.0 ],
    MaxJerk := [ 1000000.0 ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ 93368.16564640493 ],
    CurrentAcceleration := [ 47141.309576461375 ],
    TargetPosition := [ -18526.470682342333 ],
    TargetVelocity := [ -28954.455631402554 ],
    TargetAcceleration := [ 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_Acc0Acc1Vel_Udud_HasMinDuration');

ruckig();

// Step2 only finds the UDUD Acc0Acc1Vel profile if both acceleration plateaus are pinned to the limits
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step2 must find the UDUD Acc0Acc1Vel profile');
AssertEquals_LREAL(Expected := 9.4593236196069377, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_PhaseSync_Acc0_PinFallsBackToUnpinned" Id="{10623cee-7d03-4ae9-bfde-fdc052553edd}">
      <Declaration><![CDATA[METHOD Test_Trajectory_PhaseSync_Acc0_PinFallsBackToUnpinned
VAR_INST
  ruckig : Struckig.Otg(0.01, 3) := (
    Synchronization := SynchronizationType.Phase,
    MaxVelocity := [ 2224.716710588059, 15573.016974116414, 15573.016974116414 ],
    MinVelocity := [ -2224.716710588059, -15573.016974116414, -15573.016974116414 ],
    MaxAcceleration := [ 125530.25331408829, 878711.77319861797, 878711.77319861797 ],
    MinAcceleration := [ -125530.25331408829, -878711.77319861797, -878711.77319861797 ],
    MaxJerk := [ 9465132.4607314169, 66255927.225119919, 66255927.225119919 ],
    CurrentPosition := [ 0.0, 0.0, 0.0 ],
    CurrentVelocity := [ 519.11354696137778, 3633.7948287296445, 3633.7948287296445 ],
    CurrentAcceleration := [ 64094.724059937485, 448663.06841956242, 448663.06841956242 ],
    TargetPosition := [ -7.3163800204828533, -51.214660143379973, -51.214660143379973 ],
    TargetVelocity := [ 0.0, 0.0, 0.0 ],
    TargetAcceleration := [ 0.0, 0.0, 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_PhaseSync_Acc0_PinFallsBackToUnpinned');

ruckig();

// Pinning a[1] moves the final acceleration out of its precision by 1 ulp, the unpinned check has to be used instead
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Step1 must fall back to the unpinned Acc0 profile');
AssertEquals_LREAL(Expected := 0.053144816187966765, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_TimeIfNecessary_TargetAcceleration_IsSynchronized" Id="{6c1b0840-8a02-45a3-9eff-94e59f2e6b94}">
      <Declaration><![CDATA[METHOD Test_Trajectory_TimeIfNecessary_TargetAcceleration_IsSynchronized
VAR_INST
  ruckig : Struckig.Otg(0.01, 2) := (
    Synchronization := SynchronizationType.TimeIfNecessarySync,
    MaxVelocity := [ 10.0, 10.0 ],
    MaxAcceleration := [ 10.0, 10.0 ],
    MaxJerk := [ 100.0, 100.0 ],
    CurrentPosition := [ 0.0, 0.0 ],
    CurrentVelocity := [ 0.0, 0.0 ],
    CurrentAcceleration := [ 0.0, 0.0 ],
    TargetPosition := [ 100.0, 1.0 ],
    TargetVelocity := [ 0.0, 0.0 ],
    TargetAcceleration := [ 0.0, 1.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_TimeIfNecessary_TargetAcceleration_IsSynchronized');

ruckig();

// DoF 1 does not end at rest (af <> 0), so it has to be synchronized
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Synchronization failed');
AssertEquals_LREAL(Expected := 11.1, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := 11.1, Actual := ruckig._profiles[1].t_sum[6], DELTA := 1E-8, Message := 'DoF 1 is not synchronized');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_TimeIfNecessary_CurrentAcceleration_IsNotSynchronized" Id="{5559c2ef-8379-47a5-8c97-8b6074aeaa32}">
      <Declaration><![CDATA[METHOD Test_Trajectory_TimeIfNecessary_CurrentAcceleration_IsNotSynchronized
VAR_INST
  ruckig : Struckig.Otg(0.01, 2) := (
    Synchronization := SynchronizationType.TimeIfNecessarySync,
    MaxVelocity := [ 10.0, 10.0 ],
    MaxAcceleration := [ 10.0, 10.0 ],
    MaxJerk := [ 100.0, 100.0 ],
    CurrentPosition := [ 0.0, 0.0 ],
    CurrentVelocity := [ 0.0, 0.0 ],
    CurrentAcceleration := [ 0.0, 1.0 ],
    TargetPosition := [ 100.0, 1.0 ],
    TargetVelocity := [ 0.0, 0.0 ],
    TargetAcceleration := [ 0.0, 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_TimeIfNecessary_CurrentAcceleration_IsNotSynchronized');

ruckig();

// DoF 1 ends at rest, so it keeps its own minimal profile even though it starts with a0 <> 0
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Synchronization failed');
AssertEquals_LREAL(Expected := 11.1, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := 0.73088048585717125, Actual := ruckig._profiles[1].t_sum[6], DELTA := 1E-8, Message := 'DoF 1 must not be synchronized');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_Discrete_MinDuration_IsOnCycleGrid" Id="{cc955f52-4a5d-4cd2-80f6-e35dcfcf0db0}">
      <Declaration><![CDATA[METHOD Test_Trajectory_Discrete_MinDuration_IsOnCycleGrid
VAR_INST
  ruckig : Struckig.Otg(0.01, 1) := (
    Synchronization := SynchronizationType.TimeSync,
    Discretization := DiscretizationType.Discrete,
    MinDuration := 1.234,
    MaxVelocity := [ 10.0 ],
    MaxAcceleration := [ 10.0 ],
    MaxJerk := [ 100.0 ],
    CurrentPosition := [ 0.0 ],
    CurrentVelocity := [ 0.0 ],
    CurrentAcceleration := [ 0.0 ],
    TargetPosition := [ 1.0 ],
    TargetVelocity := [ 0.0 ],
    TargetAcceleration := [ 0.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_Discrete_MinDuration_IsOnCycleGrid');

ruckig();

// The minimum duration has to be rounded up to the next multiple of the cycle time as well
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Synchronization failed');
AssertEquals_LREAL(Expected := 1.24, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration not on cycle grid');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_TimeSync_TimeAcc1" Id="{9a6e4c02-ed48-4bc5-bfc0-5a52dda44a90}">
      <Declaration><![CDATA[METHOD Test_Trajectory_TimeSync_TimeAcc1
VAR_INST
  ruckig : Struckig.Otg(0.004, 6) := (
