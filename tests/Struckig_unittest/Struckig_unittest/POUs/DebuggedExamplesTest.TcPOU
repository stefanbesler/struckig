    <Method Name="Test_Trajectory_PhaseSync_RelativeCollinearity" Id="{4ab1e59c-bba2-4035-974c-41c97b5ab60c}">
      <Declaration><![CDATA[METHOD Test_Trajectory_PhaseSync_RelativeCollinearity
VAR_INST
  ruckig : Struckig.Otg(0.01, 3) := (
    Synchronization := SynchronizationType.Phase,
    MaxVelocity := [ 10000.0, 30000.0, 70000.0 ],
    MinVelocity := [ -10000.0, -30000.0, -70000.0 ],
    MaxAcceleration := [ 6000.0, 18000.0, 42000.0 ],
    MinAcceleration := [ -6000.0, -18000.0, -42000.0 ],
    MaxJerk := [ 300000.0, 900000.0, 2100000.0 ],
    CurrentPosition := [ 0.0, 0.0, 0.0 ],
    CurrentVelocity := [ -6977.5640156520003, -20932.692046955999, -48842.948109564 ],
    CurrentAcceleration := [ 0.0, 0.0, 0.0 ],
    TargetPosition := [ 3950.5409362085361, 11851.622808625609, 27653.786553459751 ],
    TargetVelocity := [ 2669.6947631748849, 8009.0842895246551, 18687.863342224195 ],
    TargetAcceleration := [ 106.52129826194442, 319.56389478583327, 745.64908783361102 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_PhaseSync_RelativeCollinearity');

ruckig();

// Relative collinearity (DiffersFromScaled) must allow phase sync (NOPHASE notcoll)
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Phase sync failed');
AssertEquals_LREAL(Expected := 3.138947828753187, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_PositionScale" Id="{17919540-5fad-40b2-b32d-14cb7b6734ba}">
      <Declaration><![CDATA[METHOD Test_Trajectory_PositionScale
VAR_INST
  ruckig : Struckig.Otg(0.001, 3) := (
    PositionScale := 2.0,
    MaxVelocity := [ 500.0, 316182.98247789982, 142354.08972914584 ],
    MaxAcceleration := [ 1000.0, 176499.25357620502, 477.32146154678702 ],
    MaxJerk := [ 100000.0, 477474.17473059369, 33330.662992663019 ],
    CurrentPosition := [ 0.0, 0.0, 0.0 ],
    CurrentVelocity := [ -190.49847932249952, -89217.066640352044, 127911.55353507209 ],
    CurrentAcceleration := [ -100.43622876874669, -142435.81979686895, 422.60978681595469 ],
    TargetPosition := [ -84.3803565885393, 3816.9149896772119, -79483.27353109252 ],
    TargetVelocity := [ 0.0, -38785.43684535566, 0.0 ],
    TargetAcceleration := [ -98.111767175202544, 0.0, 0.0 ]
  );
  p, v, a, j : ARRAY[0..Struckig.ParameterList.MaxDoFs] OF LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_PositionScale');

ruckig();

// Without scaling this case fails in synchronization, the absolute tolerances only hold in the scaled length unit
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Calculation failed');
AssertEquals_LREAL(Expected := 647.90192065547831, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');

// Inputs keep their user units
AssertEquals_LREAL(Expected := -84.3803565885393, Actual := ruckig.TargetPosition[0], DELTA := 0, Message := 'TargetPosition not restored');
AssertEquals_LREAL(Expected := 477474.17473059369, Actual := ruckig.MaxJerk[1], DELTA := 0, Message := 'MaxJerk not restored');

// Profiles are converted back to user units
ruckig.AtTime(ruckig.Duration, ADR(p), ADR(v), ADR(a), ADR(j), 0);
AssertEquals_LREAL(Expected := -84.3803565885393, Actual := p[0], DELTA := 1E-6, Message := 'Final position 0 incorrect');
AssertEquals_LREAL(Expected := 3816.9149896772119, Actual := p[1], DELTA := 1E-6, Message := 'Final position 1 incorrect');
AssertEquals_LREAL(Expected := -79483.27353109252, Actual := p[2], DELTA := 1E-6, Message := 'Final position 2 incorrect');
AssertEquals_LREAL(Expected := -38785.43684535566, Actual := v[1], DELTA := 1E-6, Message := 'Final velocity 1 incorrect');
AssertEquals_LREAL(Expected := -98.111767175202544, Actual := a[0], DELTA := 1E-8, Message := 'Final acceleration 0 incorrect');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_PositionTimeScale" Id="{1ab8fdd6-20c2-47d6-8b64-9182e69fce32}">
      <Declaration><![CDATA[METHOD Test_Trajectory_PositionTimeScale
VAR_INST
  ruckig : Struckig.Otg(0.001, 3) := (
    PositionScale := 2.0,
    TimeScale := 4.0,
    MaxVelocity := [ 500.0, 316182.98247789982, 142354.08972914584 ],
    MaxAcceleration := [ 1000.0, 176499.25357620502, 477.32146154678702 ],
    MaxJerk := [ 100000.0, 477474.17473059369, 33330.662992663019 ],
    CurrentPosition := [ 0.0, 0.0, 0.0 ],
    CurrentVelocity := [ -190.49847932249952, -89217.066640352044, 127911.55353507209 ],
    CurrentAcceleration := [ -100.43622876874669, -142435.81979686895, 422.60978681595469 ],
    TargetPosition := [ -84.3803565885393, 3816.9149896772119, -79483.27353109252 ],
    TargetVelocity := [ 0.0, -38785.43684535566, 0.0 ],
    TargetAcceleration := [ -98.111767175202544, 0.0, 0.0 ]
  );
  p, v, a, j : ARRAY[0..Struckig.ParameterList.MaxDoFs] OF LREAL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_PositionTimeScale');

ruckig();

// Power of two scales are exact, the duration equals the one with position scale only
AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.Undefined, Actual := ruckig.ErrorCode(), Message := 'Calculation failed');
AssertEquals_LREAL(Expected := 647.90192065547831, Actual := ruckig.Duration, DELTA := 1E-8, Message := 'Duration incorrect');
AssertEquals_LREAL(Expected := 0.001, Actual := ruckig.CycleTime, DELTA := 0, Message := 'CycleTime not restored');

ruckig.AtTime(ruckig.Duration, ADR(p), ADR(v), ADR(a), ADR(j), 0);
AssertEquals_LREAL(Expected := -84.3803565885393, Actual := p[0], DELTA := 1E-6, Message := 'Final position 0 incorrect');
AssertEquals_LREAL(Expected := 3816.9149896772119, Actual := p[1], DELTA := 1E-6, Message := 'Final position 1 incorrect');
AssertEquals_LREAL(Expected := -79483.27353109252, Actual := p[2], DELTA := 1E-6, Message := 'Final position 2 incorrect');
AssertEquals_LREAL(Expected := -38785.43684535566, Actual := v[1], DELTA := 1E-6, Message := 'Final velocity 1 incorrect');
AssertEquals_LREAL(Expected := -98.111767175202544, Actual := a[0], DELTA := 1E-8, Message := 'Final acceleration 0 incorrect');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="Test_Trajectory_InvalidScale" Id="{cacdac3a-0670-4ef4-93fa-0cb495ffab2d}">
      <Declaration><![CDATA[METHOD Test_Trajectory_InvalidScale
VAR_INST
  ruckig : Struckig.Otg(0.001, 1) := (
    TimeScale := 0.0,
    MaxVelocity := [ 1.0 ],
    MaxAcceleration := [ 1.0 ],
    MaxJerk := [ 1.0 ],
    TargetPosition := [ 1.0 ]
  );
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('Trajectory_InvalidScale');

ruckig();

AssertEquals_INT(Expected := Struckig.TrajectoryErrorCode.InvalidInput, Actual := ruckig.ErrorCode(), Message := 'Invalid scale accepted');
AssertEquals_LREAL(Expected := 1.0, Actual := ruckig.MaxJerk[0], DELTA := 0, Message := 'MaxJerk modified');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>