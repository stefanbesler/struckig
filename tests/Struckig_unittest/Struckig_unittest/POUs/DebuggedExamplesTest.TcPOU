Test_Trajectory_VelocityInterface_Acc0_AccelerationPlateauAtLimit();
Test_Trajectory_SecondOrder_Acc0_VelocityPlateauAtLimit();
Test_Trajectory_TimeSync_Brake_ReusesMinimalProfile();
Test_Trajectory_Acc0Acc1Vel_Udud_HasMinDuration();
Test_Trajectory_PhaseSync_Acc0_PinFallsBackToUnpinned();
Test_Trajectory_TimeIfNecessary_TargetAcceleration_IsSynchronized();
Test_Trajectory_TimeIfNecessary_CurrentAcceleration_IsNotSynchronized();
Test_Trajectory_Discrete_MinDuration_IsOnCycleGrid();
